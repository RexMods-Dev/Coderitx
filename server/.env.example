PORT=5000
NODE_ENV=development

# PostgreSQL Connection Configuration
# If DATABASE_URL or PG* variables are provided and reachable, Coderitz automatically creates
# the `enquiries` table in PostgreSQL and stores all submissions there.
# If not yet configured, submissions are safely backed up to server/data/enquiries_fallback.json.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coderitz_db

# Option 2: Individual variables
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=coderitz_db

# CORS Origin
FRONTEND_URL=http://localhost:5173

